# digest-static — dumb static file server for the shared digests/ volume.
#
# Serves two namespaces on digest.mattmariani.com:
#
#   /d/<roundSlug>/          — sprint-20 round digest html-share artifacts
#   /d2/<slug>/              — digest 2.0 share artifacts (frozen at finalize)
#   /p/<slug>/               — MLB playlist pages (music videos for a round)
#   /_bside/                 — shared b-side SPA bundle (bside.js / bside.css)
#                              Built by `cd bside && npm run build`, output
#                              copied to DIGESTS_DIR/_bside/ at deploy time.
#   /<leagueSlug>/           — sprint-32 b-side league home (SPA shell)
#   /<leagueSlug>/read_model.json — pre-computed read-model JSON (direct file)
#   /<leagueSlug>/p/<id>     → SPA fallback to /<leagueSlug>/index.html
#   /<leagueSlug>/archive    → SPA fallback to /<leagueSlug>/index.html
#   /<leagueSlug>/archive/<roundId> → SPA fallback (SPA redirects to /d/<digestSlug>)
#   /<leagueSlug>/stats/[s<N>/]  — portal stats pages (static; own block so _app/ is served)
#
#   /api/p/*                 — the ONLY dynamic route: playlist writes, proxied
#                              to the bot-ui container (see below).
#
# Bad slug (no matching directory) → 404. No league enumeration: a slug that
# has no on-disk directory returns 404 without revealing whether other slugs exist.
#
# No app, no DB, NO Cloudflare Access. Plain HTTP behind the public
# digest.mattmariani.com Cloudflare tunnel.
#
# ── Why the proxied prefix is exactly `/api/p/` and nothing else ───────────
#
# There is no Cloudflare Access in front of this host. Whatever is proxied here
# is on the open internet, unauthenticated. bot-ui is the admin app: the digest
# approval queue, the WhatsApp send endpoints, the round curation screens, the
# league database. Broadening this proxy — to `/api/*`, to `/*` with a
# static-first try_files, or to a second "just this one more" prefix — publishes
# those. That is the one property of this file that must never regress.
#
# `/api/p/` is the playlist write API and only that: a GET read model plus three
# POSTs (vote, message, identity) at /api/p/<slug>/<action>, carrying a small
# JSON body, per design/mlb-playlist-spec.md.
# The playlist page's `apiBase` defaults to `/api/p` to match.
#
# MUST NEVER BE PROXIED from this host: `/api/*` at large, `/ytm/*`, `/digests/*`,
# `/leagues/*`, `/chat/*`, anything under bot-ui's page routes, and any endpoint
# that sends WhatsApp messages. Messages from the playlist page queue for Matt's
# approval in the admin app; they never reach WhatsApp through this host.
{
	admin off
	auto_https off
}

# Internal listen port (published to the host for the cloudflared tunnel).
:8080 {
	root * /srv/digests

	encode gzip zstd

	# Don't advertise the server software.
	header -Server

	# ── Playlist write API (the only non-static route) ─────────────────────
	# Proxied to the bot-ui container by compose service name; 3002 is the port
	# bot-ui's adapter-node listens on inside the network (docker-compose.yml),
	# NOT the 3002 published to the host.
	#
	# Methods: both are live today. GET /api/p/<slug> is the page's read model
	# (tallies, band stampers, approved messages); POST /api/p/<slug>/{vote,
	# message,identity} are the three writes. Everything else is refused here
	# rather than left to SvelteKit, which would happily route a DELETE at a
	# handler that grows one later.
	@notPlaylistMethod not method POST GET
	handle /api/p/* {
		header X-Robots-Tag "noindex, nofollow"
		# `route` pins these to written order. Caddy's default directive order
		# would in fact already put `respond` ahead of `reverse_proxy`, so this
		# is belt-and-braces rather than load-bearing — but it makes the order
		# local and readable instead of a fact about Caddy's internals.
		route {
			# A wrong method on the right path is a 405, not a 404 — falling
			# through to the catch-all would read as "this API does not exist".
			respond @notPlaylistMethod 405

			# Bodies are a slug, a player id and at most a short message. The cap
			# is the backstop that keeps an anonymous public POST from being a
			# cheap way to make bot-ui buffer megabytes; bot-ui's own
			# BODY_SIZE_LIMIT is 6M because of avatar uploads on the ADMIN host,
			# which is far too generous for a route anyone can hit unauthenticated.
			request_body {
				max_size 16KB
			}
			reverse_proxy bot-ui:3002
		}
	}

	# ── Round digest html-share artifacts (sprint-20) ──────────────────────
	# Immutable-per-render; a re-export overwrites in place so links stay fresh.
	handle /d/* {
		header Cache-Control "public, max-age=300"
		file_server
	}

	# ── Digest 2.0 share artifacts ─────────────────────────────────────────
	# Same contract as /d/: folder-per-slug static copies written by bot-ui's
	# publish endpoint; a re-publish swaps the folder in place (stable links).
	# Dot-dirs (.<slug>.tmp / .<slug>.old) are publish scratch — never served.
	handle /d2/* {
		header Cache-Control "public, max-age=300"
		file_server {
			hide .*
		}
	}

	# ── Shared digest media (clips, posters) ───────────────────────────────
	# Small assets referenced by absolute URL from a rendered digest, kept
	# OUTSIDE /d/<slug>/ so a re-render of that round can't wipe them.
	handle /_media/* {
		header Cache-Control "public, max-age=86400"
		# CORS: the digest's share/save-card feature rasterizes a card to PNG with
		# html-to-image, which inlines every image via fetch. Without this the
		# canvas taints and the capture fails wherever the page isn't served from
		# this same origin (e.g. the bot-ui admin view on :3002).
		header Access-Control-Allow-Origin "*"
		file_server
	}

	# ── MLB playlist pages ─────────────────────────────────────────────────
	# Standalone, self-contained video-playlist pages (one file per round),
	# written by bot-ui at approval time. Slugs carry 16 bytes of entropy, so a
	# page is unlisted rather than secret — the link goes into a WhatsApp group.
	# Kept in its own namespace so a re-render of a round digest can never
	# overwrite one, and so /<slug>/ keeps meaning "b-side league".
	handle /p/* {
		header X-Robots-Tag "noindex, nofollow"
		header Cache-Control "public, max-age=60"
		file_server
	}

	# ── Shared b-side SPA bundle ────────────────────────────────────────────
	# Built once at deploy; all league slugs boot from this shared bundle.
	# The frontend `shell` task copies its Vite build output here.
	handle /_bside/* {
		file_server
	}

	# ── Portal stats pages (player portal piece 2) ─────────────────────────
	# Static leak-gated copies written by bot-ui's stats publisher into
	# /<slug>/stats/ and /<slug>/stats/s<N>/. They carry a SvelteKit `_app/`
	# folder, which the @league block's `hide _*` would 404 — so they get their
	# own block that hides only dot-dirs (.stats.tmp / .s<N>.old scratch).
	@portalstats path_regexp portalstats ^/[A-Za-z0-9_-]{14,}/stats(/.*)?$
	handle @portalstats {
		header X-Robots-Tag "noindex, nofollow"
		header Cache-Control "public, max-age=300"
		file_server {
			hide .*
		}
	}

	# ── B-side league routes (SPA, slug = first URL segment) ───────────────
	# League slugs are 22-char base64url strings minted by mintSlug() (16 bytes
	# of entropy). Match ≥14 chars to avoid colliding with /d/, /_bside/, etc.
	# SPA fallback: try the exact path first (serves read_model.json directly),
	# then fall back to /<slug>/index.html so client-side routes resolve.
	# Bad slug: /<slug>/index.html doesn't exist → try_files returns 404.
	@league path_regexp league ^/([A-Za-z0-9_-]{14,})(/.*)?$
	handle @league {
		header X-Robots-Tag "noindex, nofollow"
		try_files {path} {path}/ /{http.regexp.league.1}/index.html =404
		file_server {
			hide .* _*
		}
	}

	# ── Everything else → 404 ──────────────────────────────────────────────
	handle {
		respond 404
	}
}

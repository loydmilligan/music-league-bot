{
  "name": "music-league-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Private WhatsApp music league playlist bot scaffold",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "spotify-auth": "tsx scripts/spotify-oauth.ts",
    "set-group": "tsx scripts/set-group.ts",
    "add-group": "tsx scripts/add-group.ts",
    "export-bracket": "tsx scripts/export-bracket-csv.ts",
    "cover-gen": "python3 scripts/cover-gen/cli.py",
    "playlist-to-csv": "tsx scripts/playlist-to-csv.ts",
    "api": "tsx src/api/server.ts",
    "test:integration": "vitest run tests/spotify.integration.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "dotenv": "^16.4.7",
    "imapflow": "^1.4.3",
    "mailparser": "^3.9.12",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "optionalDependenciesNote": {
    "whatsapp": "Install one of: whatsapp-web.js or @whiskeysockets/baileys",
    "spotify": "Install a Spotify API client or use fetch directly",
    "youtube": "Install googleapis if using the YouTube Data API",
    "sqlite": "Install better-sqlite3 or sqlite when storage implementation begins"
  }
}

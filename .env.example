# App
NODE_ENV=development
LOG_LEVEL=debug

# WhatsApp
# Comma-separated list of allowed WhatsApp group IDs.
WHATSAPP_ALLOWED_GROUP_IDS=

# Spotify — run `npm run spotify-auth` to get SPOTIFY_REFRESH_TOKEN
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://your-domain.example.com/oauth/spotify/callback
SPOTIFY_REFRESH_TOKEN=

# YouTube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/auth/youtube/callback
YOUTUBE_REFRESH_TOKEN=

# Storage
DATABASE_URL=sqlite:./data/music-league.sqlite

OWNER_PHONE_NUMBER=1XXXXXXXXXX

# Bot control server, reachable from sibling compose containers (e.g. bot-ui
# for immediate-send /trigger calls). Not published to the host.
BOT_CONTROL_URL=http://bot:3003

MASTER_PLAYLIST_NAME=Music League — All Mentions

# UI (SvelteKit dashboard, port 3002)
# Public base URL of the deployed bot-ui app (subdomain changes periodically —
# change it here rather than hunting down hardcoded references).
PUBLIC_APP_BASE_URL=https://your-domain.example.com


# Path to the shared data directory (league.db, submissions.db, season-*/export.zip).
# Defaults to /app/data inside the bot-ui container (mounted from host ./data).
DATA_DIR=/app/data
# Your competitor id within Music League — used by the round page to mark "my submissions".
MY_COMPETITOR_ID=

# Digest LLM (OpenRouter) — required for /api/digest/:roundId/draft and regen.
OPENROUTER_API_KEY=
# Optional override; defaults to anthropic/claude-sonnet-4-5.
OPENROUTER_DIGEST_MODEL=

# Cloudflare R2 — avatar image storage (base + themed player avatars).
CF_ACCOUNT_ID=
CF_R2_API_TOKEN=
CF_R2_BUCKET=music-league-avatars

# App
NODE_ENV=development
LOG_LEVEL=debug

# WhatsApp
# Comma-separated list of allowed WhatsApp group IDs.
WHATSAPP_ALLOWED_GROUP_IDS=

# Spotify — run `npm run spotify-auth` to get SPOTIFY_REFRESH_TOKEN
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://mlbot.mattmariani.com/oauth/spotify/callback
SPOTIFY_REFRESH_TOKEN=

# YouTube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/auth/youtube/callback
YOUTUBE_REFRESH_TOKEN=

# Storage
DATABASE_URL=sqlite:./data/music-league.sqlite

# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS builder

ENV PUPPETEER_SKIP_DOWNLOAD=true

# Disable Debian's docker-clean (deletes .debs post-install) so the apt cache
# mount below actually retains downloaded packages across builds.
RUN rm -f /etc/apt/apt.conf.d/docker-clean && \
    echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-cache

# python3/make/g++ = native-module toolchain (better-sqlite3). apt cache mounts
# cache the .debs on the host so a cache-busted build reuses them instead of
# re-downloading. (Do not rm /var/lib/apt/lists — the cache mount owns it.)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++

WORKDIR /app/ui

COPY ui/package.json ui/package-lock.json* ./
# Cache mount on the npm download cache: even a cold npm ci reuses tarballs.
RUN --mount=type=cache,target=/root/.npm \
    if [ -f package-lock.json ]; then npm ci; else npm install; fi

COPY ui/ ./
# Cache mount on the vite transform cache: incremental rebuilds skip unchanged work.
RUN --mount=type=cache,target=/app/ui/node_modules/.vite npm run build

RUN npm prune --omit=dev


# chromium + fonts-liberation come from the base image (sprint-19);
# no per-build apt install of those so rebuilds stay fast.
FROM music-league-bot-base:chromium AS runtime

ENV NODE_ENV=production
ENV PORT=3002
ENV HOST=0.0.0.0
ENV DATA_DIR=/app/data
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

WORKDIR /app/ui

COPY --from=builder /app/ui/build ./build
COPY --from=builder /app/ui/node_modules ./node_modules
COPY --from=builder /app/ui/package.json ./package.json

EXPOSE 3002

CMD ["node", "build/index.js"]

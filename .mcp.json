{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "music-league": {
      "command": "node",
      "args": [
        "/home/loydmilligan/Projects/music-league-bot/mcp-server/dist/index.js"
      ],
      "env": {
        "BOT_UI_BASE_URL": "${BOT_UI_BASE_URL}",
        "BOT_UI_API_TOKEN": "${BOT_UI_API_TOKEN}"
      }
    }
  }
}

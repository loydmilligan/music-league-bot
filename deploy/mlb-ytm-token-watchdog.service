[Unit]
Description=Music League YouTube OAuth token watchdog (probe + expiry alert ladder)
After=default.target

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/music-league-bot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.nvm/versions/node/v22.22.2/bin/node %h/Projects/music-league-bot/scripts/ytm-token-watchdog.mjs
StandardOutput=journal
StandardError=journal

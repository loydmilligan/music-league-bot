[Unit]
Description=Music League auth heartbeat (writes data/ml-auth.json)
After=default.target

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/music-league-bot
Environment=PATH=%h/Projects/ttstt/venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/node %h/Projects/music-league-bot/scripts/ml-auth-probe.mjs
StandardOutput=journal
StandardError=journal

docs/prototype/
docs/*.zip
docs/*-proto/
docs/mashco-design-handoff-digest/
docs/design/**/*_unzip/

# SvelteKit build cache
.svelte-kit/

# Runtime-generated bside league slug dirs (created by the digest pipeline)
bside/public/*/

# design-sync: local bundle is just copies of source; keep only the config pin tracked
.design-sync/bundle/

# Taste Waveform design handoff package (large; not source)
taste-waveform-package/
/taste-waveform-package.zip
docs/design_handoff_sonic_signature/*.png
docs/design_handoff_sonic_signature/*.html

# Local avatar exports — avatars are served from R2 (see ui api/avatars/*), not the repo.
/avatars/

# Unzipped design-handoff / prototype dumps (curated briefs live in docs/design-briefs/).
/chat-content-handoff/
docs/design_handoff_universal_songcard/
docs/racecard/
docs/racecard-mobile/

# Design-handoff binaries & generated digest exports.
docs/design/*.zip
docs/r-*-digest-*.pdf

# Design-handoff prototype artifacts (docs/*-handoff/): the rendered design-tool
# canvas and screenshots are generated, not source. Hand-authored README /
# DECISION_LOG and sample data stay tracked (docs/design_handoff_sonic_signature
# precedent).
docs/*-handoff/**/*.dc.html
docs/*-handoff/**/screenshots/

# Python bytecode and cache
__pycache__/

# Stray root-level DB files (real data lives in data/) and env backups
/*.db
/*.sqlite
/.env.bak*

# WhatsApp cache backups (docker-owned; regenerable)
.wwebjs_cache.bak*/

# design-sync archived bundles (copies of source, like .design-sync/bundle)
.design-sync-archive/

# Design handoff zips (unzipped/curated content is what's tracked)
design/*.zip

# Local media inputs for cover-gen / digest clips (large binaries, not source)
/examples/

# cover-gen generated output
scripts/cover-gen/out/

# Raw Music League export dumps (regenerable via leagues export; zip re-importable)
exports/music-league-export-*
out/
# League media originals dropped in by hand (large; the derived clip/poster that
# actually ship live in digests/_media/).
data/second-best/*.jpeg
data/second-best/*.mp4
data/second-best/*.png

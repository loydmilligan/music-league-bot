# syntax=docker/dockerfile:1
# music-league-bot-base:chromium
#
# Stable base image that carries chromium + fonts so the app images
# (Dockerfile.ui runtime → bot-ui; root Dockerfile → bot+api) can `FROM` it
# and stop re-downloading ~150 MB of chromium on every rebuild.
#
# Build once, rebuild ONLY when chromium / the base node version changes:
#   docker build -f Dockerfile.base -t music-league-bot-base:chromium .
FROM node:22-bookworm-slim

# Debian's default `docker-clean` apt config deletes downloaded .debs right after
# install, which would defeat the cache mount below. Disable it + tell apt to keep
# downloaded packages so the .debs actually persist in the cache mount.
RUN rm -f /etc/apt/apt.conf.d/docker-clean && \
    echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-cache

# BuildKit apt cache mounts: the chromium .deb (and apt lists) are cached on the
# HOST and reused, so the very first build downloads chromium once and every
# rebuild after that hits the cache — chromium never fully re-downloads again.
# NOTE: do NOT `rm -rf /var/lib/apt/lists/*` here — the cache mount owns that dir;
# removing it would wipe the cache we just populated.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    chromium fonts-liberation

ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

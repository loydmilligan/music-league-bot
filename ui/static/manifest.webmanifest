    { "src": "/m-l-favicon-180x180.png", "sizes": "180x180", "type": "image/png" },
    { "src": "/m-l-favicon-256x256.png", "sizes": "256x256", "type": "image/png" },
    { "src": "/m-l-favicon-512x512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/m-l-maskable-512.png",    "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/m-l-apple-touch-180.png", "sizes": "180x180", "type": "image/png", "purpose": "any" }

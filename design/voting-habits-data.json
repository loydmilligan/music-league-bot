  "sampleComments": {
    "note": "Optional flavor texture, not required for the core matrix. Real ballot comments, not anonymized — round results are public.",
    "harshestDownvotes": [
      {
        "from": "Jonathan Black",
        "to": "CJ Wookie",
        "points": -2,
        "comment": "I promise I listened to the whole thing.  It was the longest song of the week by 1 second but felt much longer.  That chorus about ignorance and God - two of my least favorite things."
      },
      {
        "from": "Mashew",
        "to": "CJ Wookie",
        "points": -2,
        "comment": "Have to discourage this kind of selection early and often to send a message"
      },
      {
        "from": "Darren Paletz",
        "to": "CJ Wookie",
        "points": -2,
        "comment": "I wanted to love it....but that was truly, truly painful. It felt like I was listening to an AI generated song, that was prompted to make a campy song about 9/11 that hits on as many cliches as possible, aimed for the wide audience while appealing to nobody. That was terrible."
      },
      {
        "from": "Grant Koziol",
        "to": "CJ Wookie",
        "points": -2,
        "comment": "Fuck you"
      },
      {
        "from": "Jonathan Black",
        "to": "Jimmy Troy",
        "points": -2,
        "comment": "The album name makes it sound like it was released five decades ago, when a song like this might have been funny and/or edgy.  This asshole should have known better releasing this song in 2003."
      },
      {
        "from": "Jonathan Black",
        "to": "djensen37",
        "points": -2,
        "comment": "Hoping for a category one day where Conor decides to stop trolling."
      }
    ],
    "warmestUpvotes": [
      {
        "from": "CJ Wookie",
        "to": "Grant Koziol",
        "points": 4,
        "comment": "Thank you for a reprieve from this awful playlist."
      },
      {
        "from": "Clements",
        "to": "Jonathan Black",
        "points": 4,
        "comment": "Forgot about this song. Best reminder of the season so far."
      },
      {
        "from": "Jimmy Troy",
        "to": "Darren Paletz",
        "points": 4,
        "comment": "I appreciate the explanation and video. It was a real treat to watch…."
      },
      {
        "from": "Clements",
        "to": "Jonathan Black",
        "points": 3,
        "comment": "This one fits the theme well. Although it’s hard to listen to now."
